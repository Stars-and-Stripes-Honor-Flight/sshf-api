DB_URL=your_couchdb_url_here
DB_NAME=your_db_name_here
DB_USER=your_database_username
DB_PASS=your_database_password

# Application review database (separate CouchDB database holding VeteranApp/GuardianApp
# documents submitted from the website). REVIEW_DB_NAME is required for the
# /review/applications routes. URL/user/password default to DB_URL/DB_USER/DB_PASS
# when the review database lives on the same CouchDB server.
REVIEW_DB_NAME=hf_apps
# REVIEW_DB_URL=
# REVIEW_DB_USER=
# REVIEW_DB_PASS=

# Intake auth for POST /review/applications (called by the hf_appcollector Cloud
# Function). The function sends a Google-signed ID token; the API verifies the
# signature and audience and only accepts the service-account emails listed here.
# Comma-separated. Leave unset to disable intake entirely (fails closed with 401).
# REVIEW_INTAKE_SERVICE_ACCOUNTS=hf-appcollector@your-project.iam.gserviceaccount.com
# Expected ID-token audience. Defaults to API_URL.
# REVIEW_INTAKE_AUDIENCE=

# Comma-separated list of allowed CORS origins (defaults to localhost:3000, 127.0.0.1:3000, and localhost:8080)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,https://sshf-ui-593951006010.us-central1.run.app,https://sshf-api-330507742215.us-central1.run.app

# Public API base URL used in OpenAPI/Swagger server list (defaults to http://localhost:8080)
API_URL=http://localhost:8080

# Google OAuth client ID for Swagger UI authentication.
# Also used to validate incoming access tokens: a token is rejected unless it
# was issued for this client ID (its `aud`). This is the primary API auth gate.
GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional. Comma-separated OAuth client IDs whose access tokens are accepted.
# Overrides GOOGLE_CLIENT_ID for audience validation when multiple clients
# (e.g. a separate UI client) must be allowed. Leave unset to accept only
# GOOGLE_CLIENT_ID.
# ALLOWED_CLIENT_IDS=

# Optional defense-in-depth. Comma-separated email domains permitted to access
# the API. When set, the account must present a verified email in one of these
# domains or the request is rejected with 403 (unverified emails are rejected
# whenever this list is set). Production does not require this variable; the
# Cloud Run gate is Workspace group membership. Leave unset to skip the domain
# check.
# ALLOWED_EMAIL_DOMAINS=starsandstripeshonorflight.org

# Workspace groups that grant authorization roles (comma-separated emails).
# Role ids are fixed in code: READ, WRITE, FULL, MEDICAL, REVIEW.
# WRITE includes READ permissions. FULL includes WRITE. FULL does not include
# MEDICAL or REVIEW unless the user is also in those groups.
# Phase 2 resolves membership (direct or nested) for every group listed here,
# but data routes still require FULL. READ, WRITE, MEDICAL, and REVIEW do not
# unlock endpoints until Phase 3.
# On Cloud Run (K_SERVICE is set), AUTHZ_ROLE_FULL_GROUPS must be non-empty
# and every configured group must exist in Directory or the process exits.
# READ, WRITE, MEDICAL, and REVIEW may be unset. An unknown AUTHZ_ROLE_*_GROUPS
# name or a malformed email also fails Cloud Run startup. Local runs warn
# instead of exiting.
# Dev values are shown below. Prod uses sshf_app_prd_* on the same domain.
# AUTHZ_ROLE_READ_GROUPS=sshf_app_dev_read_access@starsandstripeshonorflight.org
# AUTHZ_ROLE_WRITE_GROUPS=sshf_app_dev_write_access@starsandstripeshonorflight.org
# AUTHZ_ROLE_FULL_GROUPS=sshf_app_dev_full_access@starsandstripeshonorflight.org
# AUTHZ_ROLE_MEDICAL_GROUPS=sshf_app_dev_medical_access@starsandstripeshonorflight.org
# AUTHZ_ROLE_REVIEW_GROUPS=sshf_app_dev_review_access@starsandstripeshonorflight.org

# Deprecated alias for AUTHZ_ROLE_FULL_GROUPS. If AUTHZ_ROLE_FULL_GROUPS is
# unset, this list is read as FULL and a deprecation warning is logged.
# If both are set, AUTHZ_ROLE_FULL_GROUPS wins, and a warning is logged when
# they differ. Removed in a later phase.
# On Cloud Run an empty FULL list (after this alias) fails startup and
# data-route authorization. Local development without K_SERVICE may leave
# both unset. If local Directory credentials are missing, authentication
# continues with no roles and, with the FULL list unset, those requests
# still reach CouchDB. With FULL configured, empty roles are 403.
# GET /user/hasgroup stays auth-only. Nested membership applies to every
# configured role group; any other group is direct membership only.
# ALLOWED_GROUP_EMAILS=sshf_app_dev_full_access@starsandstripeshonorflight.org

# Optional data-parity harness. Never set these to the production `hf` database.
# PARITY_LEGACY_DB_URL=https://db.starsandstripeshonorflight.org/test
# PARITY_MODERN_DB_URL=http://your-sshf-db-prd-host:5984/test
# Old CouchDB login (living test). Required for parity:align --apply and npm run parity.
# PARITY_LEGACY_DB_USER=
# PARITY_LEGACY_DB_PASS=
# New CouchDB login defaults to DB_USER/DB_PASS. Set these only if they differ.
# PARITY_MODERN_DB_USER=
# PARITY_MODERN_DB_PASS=
# PARITY_API_URL=http://localhost:8080
# PARITY_API_TOKEN=
# PARITY_USER_NAME=harness-user
# PARITY_SOURCE_URL=https://db.starsandstripeshonorflight.org/test
# PARITY_TARGET_URL=http://your-sshf-db-prd-host:5984/test